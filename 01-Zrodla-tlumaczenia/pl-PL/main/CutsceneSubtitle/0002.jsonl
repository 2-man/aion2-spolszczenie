{"id": "CutsceneSubtitle_S1112_Cochirun_04_cv_text", "source": "Please, kind Daeva!", "translation": "Proszę, Daevie o dobrym sercu!", "status": "draft"}
{"id": "CutsceneSubtitle_S1112_Cochirun_05_cv_text", "source": "Hurry up and free me!", "translation": "Pospiesz się i mnie uwolnij!", "status": "draft"}
{"id": "CutsceneSubtitle_S1112_Cochirun_06_cv_text", "source": "Let me out, nyerk...", "translation": "Wypuść mnie, nyerk...", "status": "draft"}
{"id": "CutsceneSubtitle_S1112_StrigikMagicBrothers_01_cv_text", "source": "Intruder!", "translation": "Intruz!", "status": "draft"}
{"id": "CutsceneSubtitle_S1112_StrigikMagicBrothers_02_cv_text", "source": "Apprehend!", "translation": "Schwytajcie go!", "status": "draft"}
{"id": "CutsceneSubtitle_S1112_StrigikMagic_01_cv_text", "source": "What's this! Intruder!", "translation": "Co takiego! Intruz!", "status": "draft"}
{"id": "CutsceneSubtitle_S1112_StrigikMagic_02_cv_text", "source": "Apprehend the trespasser!", "translation": "Schwytać intruza!", "status": "draft"}
{"id": "CutsceneSubtitle_S1113_StrigikMagicBrothers_01_cv_text", "source": "Hoohoo!", "translation": "Hu, hu!", "status": "draft"}
{"id": "CutsceneSubtitle_S1113_StrigikMagic_01_cv_text", "source": "Eeeek! Hoohoo!", "translation": "Eee! Hu, hu!", "status": "draft"}
{"id": "CutsceneSubtitle_S1113_StrigikMagic_02_cv_text", "source": "Summon the Root Guardian!", "translation": "Przywołać Strażnika Korzeni!", "status": "draft"}
{"id": "CutsceneSubtitle_S1113_StrigikMagic_03_cv_text", "source": "Summon, hoohoo!", "translation": "Przywołać go, hu, hu!", "status": "draft"}
{"id": "CutsceneSubtitle_S1113_StrigikMagic_04_cv_text", "source": "This is the end of you!", "translation": "To już twój koniec!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_01_cv_text", "source": "Save me! Save me, nyerk!", "translation": "Ratujcie! Ratujcie mnie, nyerk!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_02_cv_text", "source": "Let me down already!", "translation": "Już mnie zdejmijcie stąd!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_03_cv_text", "source": "This isn't good for my circulation!", "translation": "To szkodzi mojemu krążeniu!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_04_cv_text", "source": "Those damned Aullaeu, nyerk!", "translation": "Przeklęci Aullaeu, nyerk!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_05_cv_text", "source": "I'm innocent! Down! Let me down, nyerk!", "translation": "Jestem niewinny! Na dół! Zdejmij mnie, nyerk!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_06_cv_text", "source": "Right now,", "translation": "Już teraz,", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_07_cv_text", "source": "nyerk!", "translation": "nyerk!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_08_cv_text", "source": "Gah!", "translation": "Gah!", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_09_cv_text", "source": "Were you sent here to save me, Daeva?", "translation": "Przysłano cię, by mnie uratować, Daevie?", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_10_cv_text", "source": "I was just about to leave, nyerk.", "translation": "Właśnie miałem wychodzić, nyerk.", "status": "draft"}
{"id": "CutsceneSubtitle_S1114_Cochirun_11_cv_text", "source": "Hurry! This is the way out!", "translation": "Szybko! Tędy na zewnątrz!", "status": "draft"}
{"id": "CutsceneSubtitle_S1120_Siel_01_cv_text", "source": "You have awakened the Dream Artifact...", "translation": "Przebudzono Artefakt Snu...", "status": "draft"}
{"id": "CutsceneSubtitle_S1120_Siel_02_cv_text", "source": "I observe the beginning and the end of time.", "translation": "Obserwuję początek i koniec czasu.", "status": "draft"}
{"id": "CutsceneSubtitle_S1120_Siel_03_cv_text", "source": "An afterimage... of Empyrean Lord Siel.", "translation": "Odbicie... Władcy Empirian Siela.", "status": "draft"}
{"id": "CutsceneSubtitle_S1120_Siel_04_cv_text", "source": "Witness the memories left behind", "translation": "Ujrzyj wspomnienia pozostawione", "status": "draft"}
{"id": "CutsceneSubtitle_S1120_Siel_05_cv_text", "source": "in AION's dreams.", "translation": "w snach AION.", "status": "draft"}
{"id": "CutsceneSubtitle_S1121_Siel_01_cv_text", "source": "Follow the voice.", "translation": "Podążaj za głosem.", "status": "draft"}
{"id": "CutsceneSubtitle_S1121_Siel_02_cv_text", "source": "Transcend fate.", "translation": "Przekrocz granice przeznaczenia.", "status": "draft"}
{"id": "CutsceneSubtitle_S1121_Siel_03_cv_text", "source": "Turn dream into reality.", "translation": "Zmień sen w rzeczywistość.", "status": "draft"}
{"id": "CutsceneSubtitle_S1122_Light_01_cv_text", "source": "You who inherit the hope of AION.", "translation": "Ty dziedziczysz nadzieję AION.", "status": "draft"}
{"id": "CutsceneSubtitle_S1122_Light_02_cv_text", "source": "I am but one piece of AION's will.", "translation": "Jestem jedynie cząstką woli AION.", "status": "draft"}
{"id": "CutsceneSubtitle_S1122_Light_03_cv_text", "source": "My fall brought about this catastrophe.", "translation": "Mój upadek sprowadził tę katastrofę.", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_01_cv_text", "source": "Fafnir has been imprisoned inside the Blood Barrier.", "translation": "Fafnir został uwięziony w Krwawej Barierze.", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_02_cv_text", "source": "Ishtar fell into a long slumber, yearning for greater power.", "translation": "Ishtar zapadła w długi sen, pragnąc większej mocy.", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_03_cv_text", "source": "While the ceasefire still stands, seek hope", "translation": "Dopóki trwa zawieszenie broni, szukaj nadziei", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_04_cv_text", "source": "in the Cores left by the Empyrean Lords.", "translation": "w Rdzeniach pozostawionych przez Władców Empirian.", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_05_cv_text", "source": "The Empyrean Lords I breathed life into", "translation": "Władcy Empirian, którym dałem życie,", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_06_cv_text", "source": "sealed their Cores away across Atreia.", "translation": "zapieczętowali swoje Rdzenie w różnych zakątkach Atrei.", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_07_cv_text", "source": "The journey across the Bulwark will make you whole.", "translation": "Podróż za Wał Obronny pozwoli ci odzyskać pełnię sił.", "status": "draft"}
{"id": "CutsceneSubtitle_S1123_Light_08_cv_text", "source": "Transcend the present and reach for the future.", "translation": "Przekrocz teraźniejszość i sięgnij ku przyszłości.", "status": "draft"}
{"id": "CutsceneSubtitle_S1124_Asar_01_cv_text", "source": "I shall show what lies before you", "translation": "Ukażę ci, co cię czeka", "status": "draft"}
{"id": "CutsceneSubtitle_S1124_Asar_02_cv_text", "source": "and your mission.", "translation": "oraz jakie jest twoje zadanie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1130_Gartua_01_cv_text", "source": "All spirits shall heed Etheria's summons.", "translation": "Wszystkie duchy odpowiedzą na wezwanie Etherii.", "status": "draft"}
{"id": "CutsceneSubtitle_S1131_Laceis_01_cv_text", "source": "Thank you. I didn't want to leave Atreia.", "translation": "Dziękuję. Nie chciałem opuszczać Atrei.", "status": "draft"}
{"id": "CutsceneSubtitle_S1131_Laceis_04_cv_text", "source": "I can finally return to the Spirit Tree.", "translation": "Wreszcie mogę wrócić do Drzewa Duchów.", "status": "draft"}
{"id": "CutsceneSubtitle_S1131_Laceis_05_cv_text", "source": "Come again and visit me sometime.", "translation": "Odwiedź mnie kiedyś ponownie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Dymones_01_cv_text", "source": "A... A... Akarios? Of the Storm Legion?", "translation": "A... A... Akarios? Z Legionu Burzy?", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Dymones_02_cv_text", "source": "This cannot be...", "translation": "To niemożliwe...", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Dymones_03_cv_text", "source": "Enough with this nonsense!", "translation": "Dość tych bzdur!", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Dymones_04_cv_text", "source": "Get out.", "translation": "Wynoś się.", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Kalid_01_cv_text", "source": "Wait!", "translation": "Czekaj!", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Pernos_01_cv_text", "source": "There exists a land beyond the Bulwark. One free of despair.", "translation": "Za Wałem Obronnym znajduje się kraina wolna od rozpaczy.", "status": "draft"}
{"id": "CutsceneSubtitle_S1140_Pernos_02_cv_text", "source": "We seek to rebuild Atreia. Will you join us?", "translation": "Chcemy odbudować Atreię. Dołączysz do nas?", "status": "draft"}
{"id": "CutsceneSubtitle_S1151_Leda_01_cv_text", "source": "Using a Dragon Lord's blood...", "translation": "Używając krwi Smoczego Władcy...", "status": "draft"}
{"id": "CutsceneSubtitle_S1151_Leda_02_cv_text", "source": "Have you finally lost your mind, Akarios?", "translation": "Czyś ty postradał zmysły, Akariosie?", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_01_cv_text", "source": "So you found it.", "translation": "A więc udało ci się ją znaleźć.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_02_cv_text", "source": "You speak as if my daughter is dead.", "translation": "Mówisz tak, jakby moja córka nie żyła.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_03_cv_text", "source": "Indeed. My daughter is right here.", "translation": "Ależ ona jest tutaj, przy mnie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_04_cv_text", "source": "She will never abandon me. Unlike you.", "translation": "Nigdy mnie nie opuści. W przeciwieństwie do ciebie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_05_cv_text", "source": "That \"thing?\" Counterfeit?", "translation": "Ta „rzecz”? Podróbka?", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_06_cv_text", "source": "Akarios! Akarios!", "translation": "Akarios! Akarios!", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_07_cv_text", "source": "You've become a monster.", "translation": "Twoja przemiana uczyniła z ciebie potwora.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_08_cv_text", "source": "That \"duty\" is precisely what led Teina to her death.", "translation": "To właśnie ten „obowiązek” doprowadził do śmierci Teiny.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_09_cv_text", "source": "Even now, you seek only the core.", "translation": "Nawet teraz liczy się dla ciebie tylko Rdzeń.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_10_cv_text", "source": "I will never forgive you, Akarios!", "translation": "Nigdy ci nie wybaczę, Akariosie!", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Leda_11_cv_text", "source": "If only you'd kept your promise!", "translation": "Gdybyś tylko dotrzymał obietnicy!", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_01_cv_text", "source": "It was done for your sake.", "translation": "Zrobiłem to dla ciebie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_02_cv_text", "source": "About Teina, condolences.", "translation": "Przyjmij moje kondolencje z powodu Teiny.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_03_cv_text", "source": "I know it cannot be easy.", "translation": "Wiem, że to niełatwe.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_04_cv_text", "source": "Teina!", "translation": "Teino!", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_05_cv_text", "source": "Reda. You must learn to let her go!", "translation": "Redo. Musisz pozwolić jej odejść!", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_06_cv_text", "source": "Don't you realize? That thing is no more than a counterfeit.", "translation": "Nie rozumiesz? Ta rzecz to tylko podróbka.", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_07_cv_text", "source": "Have you lost all sense? High Priestess!", "translation": "Czyś ty postradała zmysły, Najwyższa Kapłanko?", "status": "draft"}
{"id": "CutsceneSubtitle_S1152_Pernos_08_cv_text", "source": "Have you forgotten your duty?", "translation": "Zapomniałaś o swoim obowiązku?", "status": "draft"}
{"id": "CutsceneSubtitle_S1153_Kalid_01_cv_text", "source": "Phernos... I'm not sure if this is the right thing to do.", "translation": "Phernosie... Nie wiem, czy to właściwe postępowanie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1153_Pernos_01_cv_text", "source": "Get on with it.", "translation": "Dalej, rób swoje.", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Kalid_01_cv_text", "source": "High Priestess, enough...", "translation": "Najwyższa Kapłanko, wystarczy...", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Leda_01_cv_text", "source": "Teina...", "translation": "Teino...", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Leda_02_cv_text", "source": "How cruel...", "translation": "Jakie to okrutne...", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Leda_03_cv_text", "source": "Yes...", "translation": "Tak...", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Leda_04_cv_text", "source": "It was hopeless... right from the start...", "translation": "Od samego początku... nie było nadziei...", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Pernos_01_cv_text", "source": "Teina is dead.", "translation": "Teina nie żyje.", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Pernos_02_cv_text", "source": "That is a vestige of Scarlotus. Nothing more.", "translation": "To tylko pozostałość po Scarlotus. Nic więcej.", "status": "draft"}
{"id": "CutsceneSubtitle_S1154_Pernos_03_cv_text", "source": "Leave the Illusion Core to me.", "translation": "Zostaw Rdzeń Iluzji mnie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1160_FeatherOfProtection_01_cv_text", "source": "Who dares disturb my slumber?", "translation": "Kto śmie zakłócać mój sen?", "status": "draft"}
{"id": "CutsceneSubtitle_S1160_TheRiseofProtection_01_cv_text", "source": "You who seek to claim me, I shall test your worth.", "translation": "Jeśli chcesz mnie posiąść, poddam cię próbie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1161_TheRiseofProtection_01_cv_text", "source": "You have passed my test, Daeva.", "translation": "Test został zaliczony, Daevie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1161_TheRiseofProtection_02_cv_text", "source": "Bring glory to Verteron.", "translation": "Przynieś chwałę Verteronowi.", "status": "draft"}
{"id": "CutsceneSubtitle_S1180_Kalid_01_cv_text", "source": "Phernos!", "translation": "Phernosie!", "status": "draft"}
{"id": "CutsceneSubtitle_S1180_Kalid_02_cv_text", "source": "Phernos, is that the key to the core?", "translation": "Phernosie, czy to klucz do Rdzenia?", "status": "draft"}
{"id": "CutsceneSubtitle_S1180_Pernos_01_cv_text", "source": "Am I too late...?", "translation": "Czy jest już za późno...?", "status": "draft"}
{"id": "CutsceneSubtitle_S1180_Pernos_02_cv_text", "source": "We must be swift in our search.", "translation": "Musimy się pospieszyć z poszukiwaniami.", "status": "draft"}
{"id": "CutsceneSubtitle_S1180_Pernos_03_cv_text", "source": "The Illusion Bracelet! At last.", "translation": "Bransoleta Iluzji! Nareszcie.", "status": "draft"}
{"id": "CutsceneSubtitle_S1181_Kalid_01_cv_text", "source": "We need to leave! It's too dangerous!", "translation": "Musimy uciekać! Jest zbyt niebezpiecznie!", "status": "draft"}
{"id": "CutsceneSubtitle_S1181_Kalid_02_cv_text", "source": "The Cavaliers' apparitions!", "translation": "Widmowe postacie Kawalerzystów!", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kaisinel_01_cv_text", "source": "Who are you?", "translation": "Kim jesteś?", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kaisinel_02_cv_text", "source": "Where is the high priestess?", "translation": "Gdzie jest Najwyższa Kapłanka?", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kaisinel_03_cv_text", "source": "The Illusion Core? Are you worthy?", "translation": "Rdzeń Iluzji? Czy na niego zasługujesz?", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kaisinel_04_cv_text", "source": "Arrogant Daeva...", "translation": "Daevie, co za arogancja...", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kaisinel_05_cv_text", "source": "Prove your worth.", "translation": "Udowodnij swoją wartość.", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kaisinel_06_cv_text", "source": "Fear shall swallow you whole!", "translation": "Strach pochłonie cię całkowicie!", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Kalid_01_cv_text", "source": "Lord Kaisinel...!", "translation": "Panie Kaisinel...!", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Pernos_01_cv_text", "source": "Lord of Illusion...", "translation": "Władco Iluzji...", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Pernos_02_cv_text", "source": "We come seeking the Illusion Core.", "translation": "Przybyliśmy po Rdzeń Iluzji.", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Pernos_03_cv_text", "source": "Please aid us in saving Elysea.", "translation": "Prosimy, pomóż nam ocalić Elyseę.", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Pernos_04_cv_text", "source": "We are here on behalf of the high priestess.", "translation": "Przybywamy w imieniu Najwyższej Kapłanki.", "status": "draft"}
{"id": "CutsceneSubtitle_S1191_Pernos_05_cv_text", "source": "Then let us begin.", "translation": "Zatem zaczynajmy.", "status": "draft"}
{"id": "CutsceneSubtitle_S1192_Kaisinel_01_cv_text", "source": "You have overcome fear.", "translation": "Udało ci się pokonać strach.", "status": "draft"}
{"id": "CutsceneSubtitle_S1192_Kaisinel_02_cv_text", "source": "You who seek the core...", "translation": "Szukasz Rdzenia...", "status": "draft"}
{"id": "CutsceneSubtitle_S1192_Kaisinel_03_cv_text", "source": "Face the true power of Kaisinel.", "translation": "Staw czoła prawdziwej mocy Kaisinela.", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Kaisinel_01_cv_text", "source": "What do you intend with the core?", "translation": "Co zamierzasz zrobić z Rdzeniem?", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Kaisinel_02_cv_text", "source": "Use this power to exact vengeance.", "translation": "Użyj tej mocy, by dokonać zemsty", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Kaisinel_03_cv_text", "source": "And bring triumph to Elysea.", "translation": "i zapewnić triumf Elysei.", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Kalid_01_cv_text", "source": "We must be closer now.", "translation": "Musimy być już blisko.", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Pernos_01_cv_text", "source": "I intend to save Elysea.", "translation": "Chcę ocalić Elyseę.", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Pernos_02_cv_text", "source": "You could say that.", "translation": "Można tak powiedzieć.", "status": "draft"}
{"id": "CutsceneSubtitle_S1193_Pernos_03_cv_text", "source": "We must seek the Yustiel Core in Eltnen next.", "translation": "Następnie musimy poszukać Rdzenia Yustiela w Eltnen.", "status": "draft"}
{"id": "CutsceneSubtitle_S1200_Owlamus_01_cv_text", "source": "Are you Aulamus?", "translation": "Czy jesteś Aulamusem?", "status": "draft"}
{"id": "CutsceneSubtitle_S1200_Owlamus_02_cv_text", "source": "What's this! As if I didn't have enough to-hoohoo deal with!", "translation": "Co takiego! Jakbym nie miał już dość kłopotów, hu, hu!", "status": "draft"}
{"id": "CutsceneSubtitle_S1200_Owlamus_03_cv_text", "source": "Get rid of them!", "translation": "Pozbądźcie się ich!", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Owlamus_01_cv_text", "source": "Absurdousity! If you go in there, the high priestess will kill us all!", "translation": "To niedorzeczne! Jeśli tam wejdziesz, Najwyższa Kapłanka pozabija nas wszystkich!", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Owlamus_02_cv_text", "source": "If you must insist...\nWe're out of here.", "translation": "Skoro upierasz się przy swoim...\nMy się stąd zmywamy.", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Pernos_01_cv_text", "source": "Tell me, where is the key?", "translation": "Powiedz mi, gdzie jest klucz?", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Pernos_02_cv_text", "source": "I will deal with Reda.", "translation": "Zajmę się Redą.", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Pernos_03_cv_text", "source": "Hand over the key.", "translation": "Oddaj klucz.", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Pernos_04_cv_text", "source": "Reda must have threatened them using Scarlotus.", "translation": "Reda musiała im grozić, wykorzystując Scarlotusa.", "status": "draft"}
{"id": "CutsceneSubtitle_S1201_Pernos_05_cv_text", "source": "Come. This does not bode well.", "translation": "Chodź. Źle to wróży.", "status": "draft"}
{"id": "CutsceneSubtitle_S1212_Pernos_01_cv_text", "source": "A Scarlotus circle...", "translation": "Krąg Scarlotusa...", "status": "draft"}
{"id": "CutsceneSubtitle_S1212_Pernos_02_cv_text", "source": "Reda has truly crossed the line.", "translation": "Reda naprawdę przekroczyła granice.", "status": "draft"}
{"id": "CutsceneSubtitle_S1212_Pernos_03_cv_text", "source": "It's still active.", "translation": "Nadal działa.", "status": "draft"}
