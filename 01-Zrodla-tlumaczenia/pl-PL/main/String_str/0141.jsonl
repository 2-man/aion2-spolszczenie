{"id": "String_STR_PATCH_USE_BACKGROUND_SERVICE_NOTIFICATION_body", "source": "To ensure smooth gameplay, some resources may be downloaded in the background.\nDownloading will not begin until you give your consent.", "translation": "Aby zapewnić płynną rozgrywkę, niektóre zasoby mogą być pobierane w tle.\nPobieranie rozpocznie się po wyrażeniu zgody.", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Common_AllCriticalRateUp_1_body", "source": "{active_prop.percent}% chance to increase Success Gauge by x2.5.", "translation": "{active_prop.percent}% szansy na 2,5-krotne zwiększenie wskaźnika sukcesu.", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Common_AllCriticalRateUp_2_body", "source": "{active_prop.percent}% chance to increase Success Gauge by x2.5 or x4.", "translation": "{active_prop.percent}% szansy na 2,5- lub 4-krotne zwiększenie wskaźnika sukcesu.", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Common_AllCriticalRateUp_body", "source": "Increases chances of x2/x6 Success Gauge Gain by {effect_value1.percent}%/{effect_value2.percent}% respectively.", "translation": "Zwiększa szansę na 2- i 6-krotne zwiększenie wskaźnika sukcesu odpowiednio o {effect_value1.percent}%/{effect_value2.percent}%.", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Common_FailGaugeMinus_body", "source": "Reduces Failure Gauge Gain by {effect_value1}", "translation": "Zmniejsza przyrost wskaźnika porażki o {effect_value1}", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Common_SuccessGaugeAdd_body", "source": "Increases Success Gauge Gain by {effect_value1}", "translation": "Zwiększa przyrost wskaźnika sukcesu o {effect_value1}", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_DPRecovery_body", "source": "Concluding Rapid Extraction restores Divine Power by {effect_value1.percent}", "translation": "Ukończenie szybkiego pozyskiwania przywraca {effect_value1.percent} boskiej mocy", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_ExpAdd_body", "source": "Concluding Rapid Extraction Grants Additional Combat EXP Gain by {effect_value1.percent}%", "translation": "Ukończenie szybkiego pozyskiwania zapewnia dodatkowe doświadczenie bojowe: {effect_value1.percent}%", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Food_DiscoveryAddProb_body", "source": "Successful Essence Extraction grants a {active_prop.percent}% chance to reselect Cooking Ingredient quantities.\n(Does not activate if you already have an abundant supply of the selected Cooking Ingredients)", "translation": "Po udanym pozyskiwaniu esencji istnieje {active_prop.percent}% szansy na ponowne wylosowanie ilości składników do gotowania.\n(Nie aktywuje się, jeśli masz już wystarczający zapas wybranych składników do gotowania)", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Food_MultiplyReward_body", "source": "Upon a successful Essence Extraction, has a {active_prop.percent}% chance to obtain double Gathered Materials.", "translation": "Udane pozyskiwanie esencji daje {active_prop.percent}% szansy na zdobycie podwójnej ilości zebranych materiałów.", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Food_ShowMinimapGatherSource_body", "source": "Cooking Ingredient locations are displayed on the minimap.\n(Can be toggled in the minimap options.)", "translation": "Położenie składników do gotowania jest wyświetlane na minimapie.\n(Można to włączyć lub wyłączyć w opcjach minimapy.)", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_GatherExpAdd_body", "source": "Concluding Rapid Extraction Grants Additional Proficiency Level EXP Gain by {effect_value1.percent}%", "translation": "Ukończenie szybkiego pozyskiwania zapewnia dodatkowe doświadczenie biegłości: {effect_value1.percent}%", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Herb_DiscoveryAddProb_body", "source": "Successful Essence Extraction grants a {active_prop.percent}% chance to reselect Herb grades.\n(Does not activate if higher-grade Herbs have already been discovered)", "translation": "Po udanym pozyskiwaniu esencji istnieje {active_prop.percent}% szansy na ponowny wybór klasy ziół.\n(Nie aktywuje się, jeśli odkryto już zioła wyższej klasy)", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Herb_MultiplyReward_body", "source": "Upon a successful Essence Extraction, has a {active_prop.percent}% chance to obtain double Gathered Materials.", "translation": "Udane pozyskiwanie esencji daje {active_prop.percent}% szansy na zdobycie podwójnej ilości zebranych materiałów.", "status": "draft"}
{"id": "String_STR_PC_GatherSkill_Herb_ShowMinimapGatherSource_body", "source": "Herb locations are displayed on the minimap.\n(Can be toggled in the minimap options.)", "translation": "Położenie ziół jest wyświetlane na minimapie.\n(Można to włączyć lub wyłączyć w opcjach minimapy.)", "status": "draft"}
